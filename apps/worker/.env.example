# Worker service environment (BullMQ)

# Redis connection (BullMQ broker)
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""

# Database (if workers need direct DB access)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distribution_copilot?schema=public"

# AI provider (required for scoring, risk assessment, and reply drafts)
ANTHROPIC_API_KEY=""

# Reddit and HN discovery use public APIs — no credentials needed.

# Stack Exchange API key (optional but recommended).
# Free key from https://stackapps.com/apps/oauth/register lifts the rate limit
# from 300 to 10 000 requests/day across stackoverflow.com and softwarerecs.stackexchange.com.
# STACK_EXCHANGE_KEY=""

# DEV.to API key (optional).
# Free key from https://dev.to/settings/extensions increases rate limits.
# DEVTO_API_KEY=""

# Monitor sweep interval in minutes (default: 30).
# MONITOR_INTERVAL_MINUTES="30"

# Discovery cron schedule (default: daily at 8am UTC).
# DISCOVERY_CRON="0 8 * * *"
