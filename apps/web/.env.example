# Web app environment (Next.js)

# Public URL of this app (used by the Better Auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3847"

# URL of the NestJS API (used for next.config.mjs auth proxy rewrite)
API_URL="http://localhost:3848"

# REST bridge to the API service
NEXT_PUBLIC_API_URL="http://localhost:3848"

# Stripe public price IDs (shown in upgrade/pricing UI — non-secret)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=""

# Monitoring (placeholders)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
