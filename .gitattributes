# Normalize line endings to LF in the repository for all text files.
* text=auto eol=lf

# Keep shell scripts LF regardless of platform.
*.sh text eol=lf

# Treat lockfiles as generated (collapse in diffs / PRs).
pnpm-lock.yaml linguist-generated=true

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
