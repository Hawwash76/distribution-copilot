# API service environment (NestJS)

PORT="3848"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distribution_copilot?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Auth (Better Auth)
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3848"
FRONTEND_URL="http://localhost:3847"

# AI provider (required for product profile generation)
ANTHROPIC_API_KEY=""

# Email (Resend — optional; falls back to console.log in development)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Distribution Copilot <noreply@yourdomain.com>"

# Stripe billing (optional — app works without it, Stripe features return stubs)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
