# ---------------------------------------------------------------------------
# Distribution Copilot — environment template
# Copy to `.env` and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV="development"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distribution_copilot?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""

# API service (NestJS)
PORT="4000"

# Web -> API bridge (REST)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Auth (Better Auth) — setup only, no flows implemented yet
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"

# Monitoring — placeholders only
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
