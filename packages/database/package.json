{
  "name": "@distribution-copilot/database",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsc --watch",
    "db:generate": "prisma generate",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "@distribution-copilot/eslint-config": "workspace:*",
    "@distribution-copilot/typescript-config": "workspace:*",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prisma": "^6.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
