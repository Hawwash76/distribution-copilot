// ---------------------------------------------------------------------------
// Distribution Copilot — Prisma schema.
//
// Better Auth models (User, Session, Account, Verification) are required by
// the Prisma adapter and must not be renamed. UserProfile is our extension
// for application-level profile data.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// --- Better Auth core models ------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  isDeleted     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  products      Product[]
  subscription  Subscription?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// --- Domain enums -----------------------------------------------------------

/// Source platform where a discussion lives. SERP is the discovery mechanism;
/// this enum identifies the content host (reddit, hackernews, stackoverflow,
/// lobsters, devto, or generic web).
enum DiscussionSource {
  reddit
  hackernews
  stackoverflow
  lobsters
  devto
  web

  @@map("discussion_source")
}

enum OpportunityStatus {
  new
  scored
  reviewed
  engaged
  dismissed

  @@map("opportunity_status")
}

enum RiskLevel {
  low
  medium
  high

  @@map("risk_level")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired

  @@map("subscription_status")
}

/// Intent signal that best describes why a conversation is an opportunity.
/// Classified by AI during scoring; drives reply tone and priority ordering.
enum SignalType {
  RECOMMENDATION_REQUEST
  COMPETITOR_FRUSTRATION
  ACTIVE_EVALUATION
  PAIN_EXPRESSION
  BUDGET_SIGNAL
  CATEGORY_RESEARCH

  @@map("signal_type")
}

// --- Application models -----------------------------------------------------

/// Extended profile data kept separate from the Better Auth User table.
model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  company   String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model Product {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  website          String?
  description      String?
  audience         String?
  competitors      String?
  isDeleted        Boolean          @default(false)
  lastDiscoveredAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          ProductProfile?
  opportunities    Opportunity[]
  monitors         ProductMonitor[]

  // Alert configuration — null means channel is not configured
  slackWebhookUrl  String?          // Slack incoming webhook URL
  telegramBotToken String?          // Telegram bot token from BotFather
  telegramChatId   String?          // Telegram chat/group/channel ID
  alertThreshold   Int              @default(70) // minimum overallScore to trigger an alert

  @@index([userId, isDeleted])
  @@map("products")
}

/// A source community (subreddit, etc.) where discussions are discovered.
/// Only applicable for platform sources that have communities (e.g. reddit).
model Community {
  id              String           @id @default(cuid())
  source          DiscussionSource
  externalId      String
  name            String
  description     String?
  subscriberCount Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  discussions     Discussion[]

  @@unique([source, externalId])
  @@map("communities")
}

/// A discovered online discussion fetched via SERP and content extraction.
/// Source-agnostic: can be a Reddit post, HN thread, or any web page.
/// The url field is the canonical unique identifier.
model Discussion {
  id            String           @id @default(cuid())
  source        DiscussionSource
  externalId    String?          // platform post ID (reddit base36 id, HN item id, etc.)
  url           String           @unique
  title         String
  body          String?          // extracted main text; null for link-only posts
  author        String?
  platformScore Int?             // upvotes / points from the source platform
  commentCount  Int?
  publishedAt   DateTime?
  fetchedAt     DateTime         @default(now())
  communityId   String?          // null for non-community sources (generic web)
  community     Community?       @relation(fields: [communityId], references: [id])
  opportunities Opportunity[]
  painPoints    PainPoint[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("discussions")
}

/// A pain point extracted by AI from a discussion. Linked to the discussion
/// (not the opportunity) so the same extraction is shared across products.
model PainPoint {
  id           String     @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  theme        String     // short normalized label, e.g. "Slow customer support"
  quote        String     // verbatim or lightly paraphrased excerpt from the post
  intensity    String     // "low" | "medium" | "high"
  createdAt    DateTime   @default(now())

  @@index([discussionId])
  @@map("pain_points")
}

/// A scored discussion tied to a product. Separates raw content (Discussion)
/// from product-specific scoring, risk assessment, and reply drafts.
model Opportunity {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion        @relation(fields: [discussionId], references: [id])
  status       OpportunityStatus @default(new)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Scoring fields — null until the scoring job runs
  intentScore     Int?
  relevanceScore  Int?
  painScore       Int?    // null until AI ready
  urgencyScore    Int?    // null until AI ready
  engagementScore Int?
  recencyScore    Int?
  overallScore    Int?
  scoringModel    String? // which AI model produced intent/relevance; null when partial/no-AI
  intentRationale    String? // AI explanation of intent score
  relevanceRationale String? // AI explanation of relevance score

  // Signal classification — null until AI scoring runs (requires product profile)
  signalType      SignalType? // which type of buying signal this conversation represents
  signalRationale String?     // one-sentence explanation of signal type choice

  // Risk assessment fields — null until the scoring job runs (requires product profile)
  ruleViolationRisk Int?       // 0-100: probability engaging would violate community rules
  promotionRisk     Int?       // 0-100: how overtly promotional a reply would appear
  linkRisk          Int?       // 0-100: likelihood a link would be seen as spam
  moderationRisk    Int?       // 0-100: likelihood a reply gets removed or triggers user action
  overallRisk       RiskLevel? // worst-case band derived from the four scores
  riskWarnings      String[]   // subset of: "avoid_links" | "avoid_cta" | "avoid_product_mention"
  riskRationale     String?    // one-sentence explanation of the dominant risk
  riskModel         String?    // AI model that produced the risk scores

  // Reply draft fields — null until the scoring job runs (requires product profile)
  replyDraft      String? // AI-generated draft reply for the human to review and edit
  replyDraftModel String? // AI model that produced the draft

  // Engagement tracking — set when the user replies to this conversation off-platform
  engagedAt    DateTime? // when the user marked this as engaged
  engagedReply String?   // what the user actually said in their reply

  // Alert tracking — set after Slack/Telegram notification is sent; prevents duplicate alerts
  notifiedAt   DateTime?

  @@unique([productId, discussionId])
  @@index([productId, status])
  @@index([productId, createdAt(sort: Desc)])
  @@map("opportunities")
}

/// Tracks per-source monitoring state for a product.
/// One row per (productId, source) pair. Enabled sources are swept every
/// MONITOR_INTERVAL_MINUTES by the monitor worker. lastCheckedAt drives the
/// date filter passed to each discovery source (null = backfill 30 days).
model ProductMonitor {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  source        DiscussionSource
  enabled       Boolean          @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([productId, source])
  @@index([productId])
  @@map("product_monitors")
}

/// AI-generated intelligence for a product, derived from its description.
/// Stores the 6 structured outputs produced by the generate-profile capability.
model ProductProfile {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  painPoints  String[]
  personas    String[]
  keywords    String[]
  competitors String[]
  useCases    String[]
  valueProps  String[]
  modelUsed   String
  generatedAt DateTime @default(now())

  @@map("product_profiles")
}

/// Tracks subscription and trial state for a user.
/// Created automatically on signup with status=trialing. Updated via Stripe webhooks.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(trialing)
  planName             String             @default("trial")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}
