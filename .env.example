# ---------------------------------------------------------------------------
# Distribution Copilot — environment template
# Copy to `.env` and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV="development"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distribution_copilot?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""

# API service (NestJS)
PORT="4000"

# Web -> API bridge (REST)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Auth (Better Auth)
BETTER_AUTH_SECRET="8f3f6d7b0e2c9a14d5f8e7b3c1a6f9d2b4e8c7a1f5d9e3b6c2a7f4e1d8b5c9a3"
BETTER_AUTH_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Monitoring — placeholder only
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
